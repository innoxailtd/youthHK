{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youth-hk",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "youth-hk-cms",
      "database_id": "1d1ded85-a7fd-49d1-bc41-fa9d17bbb765"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CMS_MEDIA",
      "bucket_name": "youth-hk-cms-media"
    }
  ]
}

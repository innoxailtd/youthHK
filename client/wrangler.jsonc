{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youth-hk",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"]
  // Bind production KV here after creating the namespace. The id is the
  // 32-character hex id from the Cloudflare dashboard, not a UUID:
  // "kv_namespaces": [{ "binding": "CMS_KV", "id": "<NAMESPACE_ID>" }]
}
